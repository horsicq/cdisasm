@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/cdisasmTargets.cmake")

set(cdisasm_USE_ARCH_X86 @CDISASM_NORMALIZED_USE_ARCH_X86@)
set(cdisasm_USE_ARCH_ARM @CDISASM_NORMALIZED_USE_ARCH_ARM@)
set(cdisasm_USE_ARCH_MIPS @CDISASM_NORMALIZED_USE_ARCH_MIPS@)
set(cdisasm_USE_ARCH_M68K @CDISASM_NORMALIZED_USE_ARCH_M68K@)
set(cdisasm_USE_ARCH_PPC @CDISASM_NORMALIZED_USE_ARCH_PPC@)
set(cdisasm_USE_ARCH_SPU @CDISASM_NORMALIZED_USE_ARCH_SPU@)
set(cdisasm_MIPS_BUILD_FAMILIES "@CDISASM_MIPS_BUILD_FAMILIES@")
set(cdisasm_MIPS_BUILD_FAMILY_MASK "@CDISASM_CONFIG_MIPS_FAMILY_MASK@")
set(cdisasm_USE_MIPS_ALLEGREX_UNVERIFIED @CDISASM_EFFECTIVE_USE_MIPS_ALLEGREX_UNVERIFIED@)
set(cdisasm_REQUESTED_USE_MIPS_ALLEGREX_UNVERIFIED @CDISASM_NORMALIZED_USE_MIPS_ALLEGREX_UNVERIFIED@)
set(cdisasm_REQUESTED_USE_DISASM_FORMAT @CDISASM_NORMALIZED_USE_DISASM_FORMAT@)
set(cdisasm_USE_DISASM_FORMAT @CDISASM_EFFECTIVE_USE_DISASM_FORMAT@)
set(cdisasm_REQUESTED_USE_EXTRA_OPCODES @CDISASM_NORMALIZED_USE_EXTRA_OPCODES@)
set(cdisasm_USE_EXTRA_OPCODES @CDISASM_EFFECTIVE_USE_EXTRA_OPCODES@)
set(cdisasm_BUILD_SHARED_LIBS @CDISASM_NORMALIZED_CDISASM_BUILD_SHARED_LIBS@)

set(cdisasm_common_FOUND TRUE)

if(cdisasm_USE_ARCH_X86 AND TARGET cdisasm::cdisasm_x86)
    set(cdisasm_x86_FOUND TRUE)
else()
    set(cdisasm_x86_FOUND FALSE)
endif()

if(cdisasm_USE_DISASM_FORMAT
        AND (cdisasm_USE_ARCH_X86 OR cdisasm_USE_ARCH_ARM OR cdisasm_USE_ARCH_MIPS OR cdisasm_USE_ARCH_M68K OR cdisasm_USE_ARCH_PPC OR cdisasm_USE_ARCH_SPU)
        AND TARGET cdisasm::cdisasm_format)
    set(cdisasm_format_FOUND TRUE)
else()
    set(cdisasm_format_FOUND FALSE)
endif()

if(cdisasm_USE_ARCH_ARM AND TARGET cdisasm::cdisasm_arm)
    set(cdisasm_arm_FOUND TRUE)
else()
    set(cdisasm_arm_FOUND FALSE)
endif()

if(cdisasm_USE_ARCH_MIPS AND TARGET cdisasm::cdisasm_mips)
    set(cdisasm_mips_FOUND TRUE)
else()
    set(cdisasm_mips_FOUND FALSE)
endif()

if(cdisasm_USE_ARCH_M68K AND TARGET cdisasm::cdisasm_m68k)
    set(cdisasm_m68k_FOUND TRUE)
else()
    set(cdisasm_m68k_FOUND FALSE)
endif()

if(cdisasm_USE_ARCH_PPC AND TARGET cdisasm::cdisasm_ppc)
    set(cdisasm_ppc_FOUND TRUE)
else()
    set(cdisasm_ppc_FOUND FALSE)
endif()

if(cdisasm_USE_ARCH_SPU AND TARGET cdisasm::cdisasm_spu)
    set(cdisasm_spu_FOUND TRUE)
else()
    set(cdisasm_spu_FOUND FALSE)
endif()

check_required_components(cdisasm)
